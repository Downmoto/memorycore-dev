{
	"name": "memorycore-site",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=24.9.0 <25",
		"npm": ">=11"
	},
	"scripts": {
		"dev": "vite dev",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest run --passWithNoTests",
		"test:e2e": "playwright test --pass-with-no-tests",
		"verify": "npm run format:check && npm run lint && npm run check && npm run test:unit && npm run build && npm run test:e2e"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/node": "^26.6.6",
		"eslint": "^10.14.0",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"mdsvex": "^0.12.8",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.0.7",
		"vitest": "^5.0.5",
		"wrangler": "^4.156.0"
	},
	"dependencies": {
		"@memorycore/design": "github:Downmoto/mc-design#v0.2.0",
		"phosphor-svelte": "^3.1.1"
	}
}
